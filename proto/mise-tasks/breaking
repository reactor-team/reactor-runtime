#!/usr/bin/env bash
#MISE description="[Protobuf] Detect breaking proto changes against main"
set -euo pipefail
base=main
git rev-parse --verify --quiet "$base" >/dev/null 2>&1 || base=origin/main
if git cat-file -e "$base:proto/buf.yaml" 2>/dev/null; then
  echo "--- Checking protos for breaking changes against $base"
  # buf resolves the git input path relative to the working directory, which is
  # this module's config_root (proto/), not the repo root. Anchor it at the
  # top-level .git so subdir=proto resolves from the repository root.
  buf breaking --against "$REPO_ROOT/.git#ref=$base,subdir=proto"
else
  echo "--- No proto module on $base yet; skipping breaking check"
fi
