#!/usr/bin/env bash
#MISE description="[Protobuf] Detect breaking proto changes against main"
set -euo pipefail
base=main
git rev-parse --verify --quiet "$base" >/dev/null 2>&1 || base=origin/main
if git cat-file -e "$base:proto/buf.yaml" 2>/dev/null; then
  echo "--- Checking protos for breaking changes against $base"
  buf breaking --against ".git#ref=$base,subdir=proto"
else
  echo "--- No proto module on $base yet; skipping breaking check"
fi
