#!/usr/bin/env bash
#MISE description="[Testing] Run the endurance scenarios against the runtime from source (ENDURANCE_DURATION_SECONDS sets the length; ENDURANCE_SMOKE_CYCLES=2 for a smoke run)"
set -euo pipefail
mise run //proto:gen
uv sync --locked
# The scenario files named on the command line, or every scenario when none
# is; other arguments go to pytest either way.
named=false
for arg in "$@"; do
  case "$arg" in
    *.py | *.py::*) named=true ;;
  esac
done
if [ "$named" = false ]; then
  set -- "$@" endurance-tests/tests
fi
uv run --no-sync pytest -v -s "$@"
