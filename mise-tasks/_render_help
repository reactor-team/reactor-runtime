#!/usr/bin/env python3
# fmt: off
#MISE description="[Internal] Render 'mise tasks ls -J' (stdin) as grouped `make help`"
#MISE hide=true
#MISE quiet=true
# fmt: on
"""Help renderer for the canonical Makefile shim (Makefile.mise).

The #MISE directives are wrapped in `fmt: off` because ruff's formatter would
rewrite "#MISE" to "# MISE", which mise does not recognize (the directives are
then silently ignored). mise still parses #MISE through the fmt:off marker.

Hidden + quiet, addressed //:_render_help. The shim's `help` target
pipes `mise tasks ls -l -J` in; this is a pure stdin->stdout filter (no subprocess
of its own - the Makefile already ran the listing).

argv[1] is the module directory. Like _extract_local_tasks it keeps only the tasks
under the module's //<rel>: prefix (//: at the repo root), maps the within-module
':' namespace to the make target's '-', and renders the old grouped help style:

    Usage:
      make <target>

    <Section>                (bold)
      <name>    <description> (cyan name, padded)

Sectioning. mise has no native task category - custom #MISE header keys hard-error
and there is no group field in the JSON. So a section is carried in the one field
mise treats as opaque: the description. A leading "[Section] " tag names the group;
this renderer strips it for display, mise stores it verbatim and leaves it alone.
Untagged tasks fall back to their ':' namespace (so root's lint:* / test:* still
group), then to a trailing un-headed list. The shim-provided `help` target is
appended here since it is a Makefile target, not a mise task.

Flags/args. A task that takes flagged input declares them with mise's #USAGE specs
(surfaced in the JSON `usage` field). No task needs that yet, so this renderer does
not surface usage; when one does, `usage` is the field to read here.
"""
import json
import os
import re
import sys

# Color on by default; honor the NO_COLOR convention so piped output and the
# bats contract test get clean, matchable text. (stdout.isatty() is unreliable
# here - mise may pipe the task's stdout - so gate on the env var, not the tty.)
_NO_COLOR = bool(os.environ.get("NO_COLOR"))
CYAN = "" if _NO_COLOR else "\033[36m"
BOLD = "" if _NO_COLOR else "\033[1m"
RESET = "" if _NO_COLOR else "\033[0m"

# Leading "[Section] rest-of-description" tag. Group 1 is the section name; the
# remainder is the description actually shown. mise stores the whole string.
TAG_RE = re.compile(r"^\s*\[([^\]]+)\]\s*(.*)$")

module_dir = sys.argv[1] if len(sys.argv) > 1 else os.getcwd()

# REPO_ROOT is provided by mise [env] (this runs as a mise task) - no git needed.
root = os.environ.get("REPO_ROOT", "")
rel = (
    module_dir[len(root) :].lstrip("/") if root and module_dir.startswith(root) else ""
)
prefix = "//%s:" % rel if rel else "//:"

try:
    tasks = json.load(sys.stdin)
except ValueError:
    sys.exit(0)
if isinstance(tasks, dict):
    tasks = list(tasks.values())

# (section, make-target, description); section is "" for un-grouped tasks.
rows = []
for task in tasks:
    if not isinstance(task, dict):
        continue
    name = task.get("name", "")
    if not name.startswith(prefix) or task.get("hide"):
        continue
    local = name[len(prefix) :]  # within-module name, may carry a ':' namespace
    if not local:
        continue
    target = local.replace(":", "-")  # the name you type: make <target>
    desc = task.get("description") or ""
    tag = TAG_RE.match(desc)
    if tag:
        section, desc = tag.group(1).strip(), tag.group(2)  # explicit [Section] tag
    elif ":" in local:
        section = local.split(":", 1)[0].replace("-", " ").title()  # namespace fallback
    else:
        section = ""
    rows.append((section, target, desc))

# The shim owns `help`; surface it like the old Makefile did (trailing, un-grouped).
rows.append(("", "help", "Display this help"))

width = max((len(target) for _, target, _ in rows), default=4)

out = ["", "Usage:", "  make %s<target>%s" % (CYAN, RESET)]


def emit(items):
    for _, target, desc in sorted(items, key=lambda r: r[1]):
        out.append("  %s%-*s%s  %s" % (CYAN, width, target, RESET, desc))


# Sections first (alphabetical), then any un-grouped tasks under no header.
for section in sorted({r[0] for r in rows if r[0]}):
    out.append("")
    out.append("%s%s%s" % (BOLD, section, RESET))
    emit([r for r in rows if r[0] == section])
flat = [r for r in rows if not r[0]]
if flat:
    out.append("")
    emit(flat)

out.append("")
out.append("Tip: FORCE=1 bypasses mise's sources/outputs caching.")
out.append("")
print("\n".join(out))
