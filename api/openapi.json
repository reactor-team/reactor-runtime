{
  "components": {
    "schemas": {
      "CreateUploadRequest": {
        "description": "Metadata a client announces to reserve an upload slot.\n\n``upload_id`` is optional: when omitted the store mints one, and when present\nthe slot is reserved under that exact id so a caller can seed bytes a later\nreference already names.",
        "properties": {
          "mime_type": {
            "title": "Mime Type",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          },
          "upload_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upload Id"
          }
        },
        "required": [
          "name",
          "size",
          "mime_type"
        ],
        "title": "CreateUploadRequest",
        "type": "object"
      },
      "EnforceRequest": {
        "description": "A moderation verdict posted against the active session.",
        "properties": {
          "block": {
            "default": true,
            "title": "Block",
            "type": "boolean"
          }
        },
        "title": "EnforceRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IceCandidateEntry": {
        "description": "One trickle-ICE candidate from a client.",
        "properties": {
          "candidate": {
            "title": "Candidate",
            "type": "string"
          },
          "sdp_mid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sdp Mid"
          },
          "sdp_mline_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sdp Mline Index"
          }
        },
        "required": [
          "candidate"
        ],
        "title": "IceCandidateEntry",
        "type": "object"
      },
      "IceCandidatesRequest": {
        "description": "A batch of trickle-ICE candidates from a client.",
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/IceCandidateEntry"
            },
            "title": "Candidates",
            "type": "array"
          },
          "is_final": {
            "default": false,
            "title": "Is Final",
            "type": "boolean"
          }
        },
        "title": "IceCandidatesRequest",
        "type": "object"
      },
      "IceServerEntry": {
        "description": "One STUN/TURN server offered for this connection's candidate gathering.\n\nMirrors the wire shape the platform already uses for ICE servers:\n``{uris, credentials: {username, password}}``, with ``credentials`` absent\nfor a STUN server.",
        "properties": {
          "credentials": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TurnCredentials"
              },
              {
                "type": "null"
              }
            ]
          },
          "uris": {
            "items": {
              "type": "string"
            },
            "title": "Uris",
            "type": "array"
          }
        },
        "required": [
          "uris"
        ],
        "title": "IceServerEntry",
        "type": "object"
      },
      "SdpParamsRequest": {
        "description": "A client's SDP offer, the tracks it declares, and optional ICE servers.\n\n``ice_servers`` lets the caller supply the STUN/TURN servers this connection\ngathers against. Absent, the runtime uses its own configured servers; present\n(even empty), it is authoritative for the connection \u2014 so a reconnect can\ncarry fresh credentials.",
        "properties": {
          "ice_servers": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/IceServerEntry"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ice Servers"
          },
          "sdp_offer": {
            "title": "Sdp Offer",
            "type": "string"
          },
          "track_mapping": {
            "items": {
              "$ref": "#/components/schemas/TrackMappingEntry"
            },
            "title": "Track Mapping",
            "type": "array"
          }
        },
        "required": [
          "sdp_offer"
        ],
        "title": "SdpParamsRequest",
        "type": "object"
      },
      "TrackMappingEntry": {
        "description": "One track a client declares with its offer.",
        "properties": {
          "direction": {
            "title": "Direction",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "mid": {
            "title": "Mid",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "mid",
          "name",
          "kind",
          "direction"
        ],
        "title": "TrackMappingEntry",
        "type": "object"
      },
      "TurnCredentials": {
        "description": "TURN authentication for an ICE server; absent on a plain STUN server.",
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "TurnCredentials",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
