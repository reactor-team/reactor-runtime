{
  "components": {
    "schemas": {
      "CreateUploadRequest": {
        "description": "Metadata a client announces to reserve an upload slot.\n\n``upload_id`` is optional: when omitted the store mints one, and when present\nthe slot is reserved under that exact id so a caller can seed bytes a later\nreference already names.",
        "properties": {
          "mime_type": {
            "title": "Mime Type",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "size": {
            "title": "Size",
            "type": "integer"
          },
          "upload_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upload Id"
          }
        },
        "required": [
          "name",
          "size",
          "mime_type"
        ],
        "title": "CreateUploadRequest",
        "type": "object"
      },
      "CreateUploadResponse": {
        "description": "The reserved slot: its id, the URL to PUT the bytes to, and its path.",
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "presigned_id": {
            "title": "Presigned Id",
            "type": "string"
          },
          "presigned_url": {
            "title": "Presigned Url",
            "type": "string"
          }
        },
        "required": [
          "presigned_id",
          "presigned_url",
          "path"
        ],
        "title": "CreateUploadResponse",
        "type": "object"
      },
      "ErrorDetail": {
        "description": "The body every rejected request carries: a human-readable motive.\n\nThe one error shape of the HTTP surface \u2014 the fixed route groups and the\ntransport route groups alike declare their non-2xx responses with it, so a\nclient generating types from the published contract sees the same\n``{\"detail\": ...}`` body everywhere.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "The process verdict, the lifecycle word behind it, and why.\n\n``status`` is the machine-checkable verdict a probe branches on; ``state``\nsays what the process is doing, which a probe reads to tell a runtime that\ncannot serve yet from one that is finished; ``detail`` explains an unhealthy\nverdict.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "state": {
            "$ref": "#/components/schemas/RuntimeState"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "required": [
          "status",
          "state",
          "detail"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HealthStatus": {
        "description": "A component's verdict on itself: working or broken.\n\nDeliberately two-valued so the verdict is machine-checkable \u2014 a probe\nbranches on it without interpretation. The lifecycle word a human reads\nalongside it is :class:`RuntimeState`.",
        "enum": [
          "unhealthy",
          "healthy"
        ],
        "title": "HealthStatus",
        "type": "string"
      },
      "IceCandidateEntry": {
        "description": "One trickle-ICE candidate from a client.",
        "properties": {
          "candidate": {
            "title": "Candidate",
            "type": "string"
          },
          "sdp_mid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sdp Mid"
          },
          "sdp_mline_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sdp Mline Index"
          }
        },
        "required": [
          "candidate"
        ],
        "title": "IceCandidateEntry",
        "type": "object"
      },
      "IceCandidatesRequest": {
        "description": "A batch of trickle-ICE candidates from a client.",
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/IceCandidateEntry"
            },
            "title": "Candidates",
            "type": "array"
          },
          "is_final": {
            "default": false,
            "title": "Is Final",
            "type": "boolean"
          }
        },
        "title": "IceCandidatesRequest",
        "type": "object"
      },
      "IceServerEntry": {
        "description": "One STUN/TURN server offered for this connection's candidate gathering.\n\nMirrors the wire shape the platform already uses for ICE servers:\n``{uris, credentials: {username, password}}``, with ``credentials`` absent\nfor a STUN server.",
        "properties": {
          "credentials": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TurnCredentials"
              },
              {
                "type": "null"
              }
            ]
          },
          "uris": {
            "items": {
              "type": "string"
            },
            "title": "Uris",
            "type": "array"
          }
        },
        "required": [
          "uris"
        ],
        "title": "IceServerEntry",
        "type": "object"
      },
      "OfferAccepted": {
        "description": "The offer is accepted for asynchronous negotiation; poll for the answer.",
        "properties": {
          "connection_id": {
            "title": "Connection Id",
            "type": "integer"
          }
        },
        "required": [
          "connection_id"
        ],
        "title": "OfferAccepted",
        "type": "object"
      },
      "RegisterConnectionResponse": {
        "description": "A minted connection id and the model's track manifest for transceiver setup.",
        "properties": {
          "connection_id": {
            "title": "Connection Id",
            "type": "integer"
          },
          "track_map": {
            "additionalProperties": true,
            "title": "Track Map",
            "type": "object"
          }
        },
        "required": [
          "connection_id",
          "track_map"
        ],
        "title": "RegisterConnectionResponse",
        "type": "object"
      },
      "RuntimeState": {
        "description": "The lifecycle word describing what the process is doing right now.\n\nOrthogonal to :class:`HealthStatus`: where the status says whether the\nprocess is working, the state says what it is up to.\n\nStates:\n    LOADING: The model is still loading; a session cannot be opened yet.\n    AVAILABLE: The model is loaded and idle, ready to open a session.\n    SERVING: A session is open, from its start through its teardown.\n    TERMINATED: The process is finished and will not serve again.",
        "enum": [
          "loading",
          "available",
          "serving",
          "terminated"
        ],
        "title": "RuntimeState",
        "type": "string"
      },
      "SdpAnswerResponse": {
        "description": "The negotiated SDP answer for a connection.",
        "properties": {
          "connection_id": {
            "title": "Connection Id",
            "type": "integer"
          },
          "sdp_answer": {
            "title": "Sdp Answer",
            "type": "string"
          }
        },
        "required": [
          "sdp_answer",
          "connection_id"
        ],
        "title": "SdpAnswerResponse",
        "type": "object"
      },
      "SdpParamsRequest": {
        "description": "A client's SDP offer, the tracks it declares, and optional ICE servers.\n\n``ice_servers`` lets the caller supply the STUN/TURN servers this connection\ngathers against. Absent, the runtime uses its own configured servers; present\n(even empty), it is authoritative for the connection \u2014 so a reconnect can\ncarry fresh credentials.",
        "properties": {
          "ice_servers": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/IceServerEntry"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ice Servers"
          },
          "sdp_offer": {
            "title": "Sdp Offer",
            "type": "string"
          },
          "track_mapping": {
            "items": {
              "$ref": "#/components/schemas/TrackMappingEntry"
            },
            "title": "Track Mapping",
            "type": "array"
          }
        },
        "required": [
          "sdp_offer"
        ],
        "title": "SdpParamsRequest",
        "type": "object"
      },
      "StopSessionRequest": {
        "description": "Optional qualifiers on a session stop.\n\n``moderate`` marks the stop as a content-moderation verdict: the session\nends as moderated and clients are notified before their connections close.\n``reason`` is the platform's close-reason token (e.g. ``\"deployment\"``):\nwhen set, clients receive a session-ended notice naming the reason before\ntheir connections close. A moderated stop outranks the token \u2014 clients see\nonly the moderation notice. The body itself is optional \u2014 a bare\n``POST /stop_session`` is a plain stop.",
        "properties": {
          "moderate": {
            "default": false,
            "title": "Moderate",
            "type": "boolean"
          },
          "reason": {
            "default": "",
            "maxLength": 64,
            "title": "Reason",
            "type": "string"
          }
        },
        "title": "StopSessionRequest",
        "type": "object"
      },
      "TrackMappingEntry": {
        "description": "One track a client declares with its offer.",
        "properties": {
          "direction": {
            "title": "Direction",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "mid": {
            "title": "Mid",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "mid",
          "name",
          "kind",
          "direction"
        ],
        "title": "TrackMappingEntry",
        "type": "object"
      },
      "TurnCredentials": {
        "description": "TURN authentication for an ICE server; absent on a plain STUN server.",
        "properties": {
          "password": {
            "title": "Password",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "TurnCredentials",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "reactor-runtime",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/clips": {
      "get": {
        "operationId": "get_clip_manifest_clips_get",
        "parameters": [
          {
            "in": "query",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "start",
            "required": true,
            "schema": {
              "title": "Start",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "end",
            "required": true,
            "schema": {
              "title": "End",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/vnd.apple.mpegurl": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "The clip's HLS manifest."
          },
          "202": {
            "description": "Still being prepared; retry later."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Bad Request"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Gone"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Clip Manifest"
      }
    },
    "/clips/chunks/{session_id}/{filename}": {
      "get": {
        "operationId": "get_clip_chunk_clips_chunks__session_id___filename__get",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "filename",
            "required": true,
            "schema": {
              "title": "Filename",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "video/iso.segment": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "video/mp4": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The fMP4 segment bytes."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Not Found"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Gone"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Clip Chunk"
      }
    },
    "/events": {
      "get": {
        "operationId": "events_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since"
            }
          },
          {
            "in": "header",
            "name": "last-event-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "The egress journal as a server-sent event stream."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Events"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "The process is unhealthy."
          }
        },
        "summary": "Health"
      }
    },
    "/metrics": {
      "get": {
        "operationId": "scrape_metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "The process's instruments in the Prometheus text format."
          }
        },
        "summary": "Scrape Metrics"
      }
    },
    "/schema": {
      "get": {
        "operationId": "get_schema_schema_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Schema Schema Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Schema"
      }
    },
    "/session": {
      "get": {
        "operationId": "get_session_session_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Session Session Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Session"
      }
    },
    "/sessions/{sid}/transport/webrtc/connections": {
      "post": {
        "operationId": "register_sessions__sid__transport_webrtc_connections_post",
        "parameters": [
          {
            "in": "path",
            "name": "sid",
            "required": true,
            "schema": {
              "title": "Sid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterConnectionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Register"
      }
    },
    "/sessions/{sid}/transport/webrtc/connections/{cid}/ice_candidates": {
      "post": {
        "operationId": "ice_sessions__sid__transport_webrtc_connections__cid__ice_candidates_post",
        "parameters": [
          {
            "in": "path",
            "name": "sid",
            "required": true,
            "schema": {
              "title": "Sid",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "cid",
            "required": true,
            "schema": {
              "title": "Cid",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IceCandidatesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ice"
      }
    },
    "/sessions/{sid}/transport/webrtc/connections/{cid}/sdp_params": {
      "get": {
        "operationId": "sdp_answer_sessions__sid__transport_webrtc_connections__cid__sdp_params_get",
        "parameters": [
          {
            "in": "path",
            "name": "sid",
            "required": true,
            "schema": {
              "title": "Sid",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "cid",
            "required": true,
            "schema": {
              "title": "Cid",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SdpAnswerResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "202": {
            "description": "Negotiation still in flight; poll again."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sdp Answer"
      },
      "post": {
        "operationId": "offer_sessions__sid__transport_webrtc_connections__cid__sdp_params_post",
        "parameters": [
          {
            "in": "path",
            "name": "sid",
            "required": true,
            "schema": {
              "title": "Sid",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "cid",
            "required": true,
            "schema": {
              "title": "Cid",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "reactor-webrtc-version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Reactor-Webrtc-Version"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SdpParamsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferAccepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetail"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
